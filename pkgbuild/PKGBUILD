pkgname=wondersland-game
pkgver=0.3.2
pkgrel=1
pkgdesc='WondersLand [WL] — a pixel runner through real Bitcoin transactions'
arch=('x86_64' 'aarch64')
license=('MIT')
options=('!debug')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland')
makedepends=('gcc' 'make')
source=()
sha256sums=()
build() { cd "$startdir/.."; ./bin/build; }
package() {
 cd "$startdir/.."
 install -Dm755 build/wondersland-game "$pkgdir/usr/bin/wondersland-game"
 install -Dm644 LICENSE "$pkgdir/usr/share/licenses/wondersland-game/LICENSE"
 install -Dm644 pkgbuild/wondersland-game.desktop "$pkgdir/usr/share/applications/wondersland-game.desktop"
 install -Dm644 pkgbuild/wondersland-game.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/wondersland-game.svg"
}
