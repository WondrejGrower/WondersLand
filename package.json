{
  "name": "wondersland-wl",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node web/build.mjs",
    "build:web": "node web/build.mjs",
    "dev": "wrangler dev",
    "test": "node --test web/core.test.mjs web/worker.test.mjs web/feed.test.mjs web/inventory.test.mjs web/environment.test.mjs web/leaderboard.test.mjs web/viewport.test.mjs web/security.test.mjs web/verified.test.mjs",
    "deploy:check": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "test:browser": "npm run build && node web/browser.test.mjs",
    "test:results": "npm run build && node web/results.test.mjs",
    "test:roles": "npm run build && node web/roles.test.mjs",
    "test:input-feed": "npm run build && node web/input-feed.test.mjs",
    "test:inventory": "npm run build && node web/inventory-browser.test.mjs",
    "test:environment": "npm run build && node web/environment-browser.test.mjs",
    "test:jump-input": "npm run build && node web/jump-input-browser.mjs",
    "test:monthly": "npm run build && node web/monthly-browser.test.mjs",
    "test:mobile": "npm run build && node web/mobile-browser.test.mjs",
    "test:pwa": "npm run build && node web/pwa-browser.test.mjs",
    "build:checked": "npm test && npm audit --audit-level=low && npm run build",
    "test:verified": "npm run build && node web/verified-browser.test.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "wrangler": "4.158.0"
  }
}
