{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wondersland",
  "main": "web/worker.mjs",
  "compatibility_date": "2026-11-08",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "wondersland.online",
      "custom_domain": true
    },
    {
      "pattern": "www.wondersland.online",
      "custom_domain": true
    }
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "build": {
    "command": "npm run build:checked",
    "watch_dir": [
      "src",
      "web"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LEADERBOARD",
        "class_name": "MonthlyLeaderboard"
      }
    ]
  },
  "exports": {
    "MonthlyLeaderboard": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "ratelimits": [
    {
      "name": "EDGE_API_LIMIT",
      "namespace_id": "13033001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "EDGE_WRITE_LIMIT",
      "namespace_id": "13033002",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ],
  "dev": {
    "local_protocol": "https",
    "host": "wondersland.online"
  }
}
