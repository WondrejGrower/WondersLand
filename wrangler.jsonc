{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wondersland",
  "main": "web/worker.mjs",
  "compatibility_date": "2026-11-08",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "wondersland.online",
      "custom_domain": true
    },
    {
      "pattern": "www.wondersland.online",
      "custom_domain": true
    }
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "npm run build"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LEADERBOARD",
        "class_name": "MonthlyLeaderboard"
      }
    ]
  },
  "exports": {
    "MonthlyLeaderboard": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
